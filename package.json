{
  "name": "yannabadie.github.io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Yann Abadie: portfolio site (static, Astro) for the GitHub Pages user site https://yannabadie.github.io/ (deployed by .github/workflows/deploy.yml).",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4321",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "astro": "astro",
    "budget": "node scripts/budget.mjs",
    "validate": "html-validate \"dist/**/*.html\"",
    "verify": "npm run build && npm run check && npm run budget && npm run validate"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "html-validate": "11.21.1",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3"
  }
}
